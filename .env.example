# Copy to .env.local for local testing, and add the same names in
# Vercel → Project → Settings → Environment Variables for the live site.
# Never commit real values.

# Resend (https://resend.com) — contact form, newsletter sign-ups and welcome emails
RESEND_API_KEY=
# Inbox that receives contact form messages
CONTACT_TO_EMAIL=
# Sender on a domain verified in Resend (required for emails to reach subscribers)
CONTACT_FROM_EMAIL="Hala Equity Heroes <hello@yourdomain.org>"
# Optional: Resend segment that newsletter subscribers are added to
RESEND_SEGMENT_ID=
# Optional: inbox that receives replies to newsletter emails
NEWSLETTER_REPLY_TO=
# Long random string that signs unsubscribe links, e.g. from: openssl rand -base64 32
NEWSLETTER_SECRET=

# Hosted donation pages (Stripe Payment Link, Donorbox, PayPal Giving Fund, ...)
NEXT_PUBLIC_DONATION_URL=
NEXT_PUBLIC_MONTHLY_DONATION_URL=

# Optional: custom domain, if the site moves off halaequityheroes.vercel.app
NEXT_PUBLIC_SITE_URL=
